# Copy to server/.env and fill in. server/.env is gitignored.

# Core
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/campus-gate-pass

# Auth (JWT_SECRET is REQUIRED — the server refuses to start without it)
JWT_SECRET=a_long_random_secret_change_me
JWT_EXPIRE=30d

# Parent OTP via Twilio (optional — falls back to console logging in dev).
# Needs the Account SID (AC...), a From number / Messaging Service SID, and either
# an Auth Token OR an API Key (SK...) + secret.
TWILIO_ACCOUNT_SID=
TWILIO_FROM=
TWILIO_AUTH_TOKEN=
# Or API Key auth instead of the Auth Token:
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Password-reset email via SMTP (optional — falls back to console logging in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=

# Optional
# CORS_ORIGINS=https://your-frontend.example.com,https://another.example.com
# ENABLE_SCHEDULER=true
# EXPOSE_RESET_TOKEN=false   # local testing only — never set true in production
# DEV_ADMIN_EMAIL=
# DEV_ADMIN_PASSWORD=
